# Copia este archivo a .env y ajusta los valores.
#   cp .env.ejemplo .env

# --- Obligatorias ----------------------------------------------------------

# Clave de la base. Cambiala.
POSTGRES_PASSWORD=cambia-esta-clave

# Firma los tokens de sesion. Sin ella la aplicacion se niega a arrancar, que
# es lo correcto: una clave por defecto convertiria la firma en decorativa.
# Genera una con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
BUSINT_CLAVE_FIRMA=

# --- Origen de datos -------------------------------------------------------
# erp   lee del API del ERP        (necesita BUSINT_ERP_URL)
# excel lee un .xlsx exportado     (necesita BUSINT_ARCHIVO)
# csv   lee un archivo delimitado  (necesita BUSINT_ARCHIVO)
BUSINT_ORIGEN=excel
BUSINT_ARCHIVO=/datos/cartera.xlsx
BUSINT_ERP_URL=
BUSINT_ERP_TOKEN=

# --- Recalculo diario (§10.2) ----------------------------------------------
# Ponlo en 1 cuando el origen sea estable. La hora es de America/Bogota (C-11).
BUSINT_PROGRAMAR=0
BUSINT_EMPRESAS=E01
BUSINT_HORA_CORTE=5
