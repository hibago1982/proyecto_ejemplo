# Panel: se construye el frontend y se sirve con nginx.
#
# Va aparte de la imagen de la aplicacion porque son dos cosas distintas: el
# panel es estatico y lo sirve nginx, mientras el API necesita Python.

FROM node:22-slim AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY contrato/ /contrato/
COPY frontend/ ./
RUN npm run build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY despliegue/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
